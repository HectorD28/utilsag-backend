# Application
APP_NAME=UtilSAG-AI Backend
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL (utilsag_app role - HU-02 CA-3)
DATABASE_URL=postgresql+asyncpg://utilsag_app:CHANGE_ME@192.168.30.190:5432/utilsag_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# LLM Orchestration (HU-11)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_RETRIES=2

# Kill Switch Admin Security (HU-12)
ADMIN_KILLSWITCH_KEY=CHANGE_ME_ADMIN_KEY
